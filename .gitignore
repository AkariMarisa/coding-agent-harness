# Rust build output
/target/
/src/target/
**/target/

# Local tool cache (mounted into the dev container)
/.cache/

# Loom runtime state (per project, never committed)
/.worktrees/
/.smoke/
/.smoke-*/

# Local env / logs / editor noise
.env
.env.*
!.env.example
*.log
.DS_Store
.idea/
.vscode/

# OS / temporary
*.swp
*.tmp

# loom: contract layer tracked, state layer ignored (whitelist)
/.loom/*
!/.loom/README.md
!/.loom/README.zh-CN.md
!/.loom/goal.md
!/.loom/constraints.md
!/.loom/specs/
.worktrees/
