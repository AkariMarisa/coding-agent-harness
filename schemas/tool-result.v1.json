{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loom.dev/schemas/tool-result.v1.json",
  "title": "Loom Tool Result Envelope v1",
  "description": "Compact envelope returned by tools to the model. Full text spills to an artifact; items carry only addresses and previews.",
  "type": "object",
  "required": ["v", "ok", "tool"],
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1,
      "description": "Protocol version; treated as v1 when absent."
    },
    "ok": {
      "type": "boolean"
    },
    "tool": {
      "type": "string",
      "enum": [
        "search",
        "read",
        "tree",
        "glob",
        "diff",
        "verify",
        "log",
        "git",
        "edit",
        "write",
        "bash",
        "artifact"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 300,
      "description": "One-line human-readable summary, localized by LOOM_LANG."
    },
    "items": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/item" }
    },
    "text": {
      "type": "string",
      "description": "Bounded body from read/artifact/log tools; the full text remains in the artifact that ref points to."
    },
    "ref": {
      "type": "string",
      "pattern": "^artifacts/[A-Za-z0-9._-]+$",
      "description": "Artifact path relative to the run directory."
    },
    "truncated": {
      "type": "boolean"
    },
    "next": {
      "type": "string",
      "maxLength": 200,
      "description": "Opaque pagination cursor; present only when truncated=true."
    },
    "unchanged": {
      "type": "boolean",
      "description": "The same content was already returned within this run; items may be omitted."
    },
    "stats": {
      "$ref": "#/$defs/stats"
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "err": {
      "$ref": "#/$defs/error"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "ok": { "const": false } },
        "required": ["ok"]
      },
      "then": { "required": ["err"] }
    },
    {
      "if": {
        "properties": { "ok": { "const": true } },
        "required": ["ok"]
      },
      "then": { "not": { "required": ["err"] } }
    }
  ],
  "$defs": {
    "item": {
      "type": "object",
      "required": ["t"],
      "additionalProperties": false,
      "properties": {
        "t": {
          "type": "string",
          "enum": ["match", "file", "dir", "path", "hunk", "log", "symbol"]
        },
        "p": {
          "type": "string",
          "maxLength": 1024,
          "description": "Repository-relative path."
        },
        "b": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,64}$",
          "description": "Content hash (git blob or sha256 prefix)."
        },
        "r": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 1 },
          "description": "1-based closed-interval line numbers [start, end]."
        },
        "s": {
          "type": "string",
          "maxLength": 300,
          "description": "Symbol name."
        },
        "k": {
          "type": "string",
          "enum": ["def", "ref", "call", "type", "test", "doc", "config", "other"]
        },
        "x": {
          "type": "string",
          "maxLength": 400,
          "description": "Single-line preview; truncated at UTF-8 character boundaries."
        },
        "sc": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "n": {
          "type": "integer",
          "minimum": 0,
          "description": "Total count / sub-item count / total line count, interpreted per t."
        },
        "a": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of added lines."
        },
        "d": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of deleted lines."
        },
        "l": {
          "type": "string",
          "maxLength": 20,
          "description": "Language identifier, e.g. rust/ts/py."
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of results (not the number returned this time)."
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Actual UTF-8 byte size of this envelope."
        },
        "tok": {
          "type": "integer",
          "minimum": 0,
          "description": "Estimated token count, not exact."
        },
        "spill": {
          "type": "boolean",
          "description": "Whether the full text spilled to an artifact."
        },
        "dedupe": {
          "type": "boolean",
          "description": "Whether it hit this run's dedup set."
        }
      }
    },
    "budget": {
      "type": "object",
      "required": ["u", "l"],
      "additionalProperties": false,
      "properties": {
        "u": {
          "type": "integer",
          "minimum": 0,
          "description": "Bytes used."
        },
        "l": {
          "type": "integer",
          "minimum": 1,
          "description": "Byte limit."
        },
        "p": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "at": {
          "type": "string",
          "enum": ["call", "invocation", "run"]
        }
      },
      "description": "Present only after usage reaches 75%."
    },
    "error": {
      "type": "object",
      "required": ["code"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "invalid_args",
            "not_found",
            "too_large",
            "binary",
            "timeout",
            "permission",
            "stale",
            "stale_cursor",
            "budget",
            "internal"
          ]
        },
        "hint": {
          "type": "string",
          "maxLength": 200,
          "description": "Suggested next step, e.g. read --range 1:200."
        },
        "detail": {
          "type": "string",
          "maxLength": 500,
          "description": "One-line diagnostic; stack traces are forbidden."
        }
      }
    }
  }
}
