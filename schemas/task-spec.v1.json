{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loom.local/schema/task-spec.v1.json",
  "title": "TaskSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "goal_id",
    "title",
    "role",
    "tier",
    "depends_on",
    "workspace",
    "inputs",
    "constraints",
    "acceptance",
    "budget",
    "output"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "pattern": "^T-[0-9]{8}-[0-9]{3}$"},
    "goal_id": {"type": "string", "pattern": "^G-[A-Za-z0-9-]+$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 80},
    "role": {
      "enum": ["survey", "spec-tests", "implement", "review", "judgment", "docs"]
    },
    "tier": {"enum": ["frontier", "worker"]},
    "depends_on": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "base_ref", "branch", "allowed_paths"],
      "properties": {
        "mode": {"enum": ["worktree", "in_place"]},
        "base_ref": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1},
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "forbidden_paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "default": []
        }
      }
    },
    "inputs": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "range": {
            "type": "array",
            "prefixItems": [
              {"type": "integer", "minimum": 1},
              {"type": "integer", "minimum": 1}
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "must_read": {"type": "boolean", "default": false}
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_files_touched": {"type": "integer", "minimum": 1},
        "no_new_dependencies": {"type": "boolean", "default": false},
        "style": {"type": "array", "items": {"type": "string"}, "default": []},
        "notes": {"type": "string", "maxLength": 500}
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "cmd"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
          "cmd": {"type": "string", "minLength": 1},
          "expect_exit": {"type": "integer", "minimum": 0, "maximum": 255, "default": 0},
          "timeout_s": {"type": "integer", "minimum": 1, "default": 300}
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_input_tokens": {"type": "integer", "minimum": 1},
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "max_steps": {"type": "integer", "minimum": 1},
        "max_wall_s": {"type": "integer", "minimum": 1},
        "max_cost_usd": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt", "report_path"],
      "properties": {
        "receipt": {"const": "4-line"},
        "report_path": {"type": "string", "minLength": 1},
        "required_artifacts": {
          "type": "array",
          "items": {"type": "string"},
          "default": []
        }
      }
    },
    "context_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_must_read_files": {"type": "integer", "minimum": 1, "default": 5},
        "max_must_read_tokens": {"type": "integer", "minimum": 1, "default": 40000},
        "allow_extra_reads": {"type": "boolean", "default": true},
        "forbid_full_repo_scan": {"type": "boolean", "default": true}
      }
    },
    "notes": {"type": "string", "maxLength": 500}
  }
}
