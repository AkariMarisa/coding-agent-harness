{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loom.local/schema/adapter-usage.v1.json",
  "title": "AdapterUsageRow",
  "description": "One line of outbox/usage.jsonl written by an adapter. The control plane normalizes these rows into the request ledger.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "run_id", "task_id"],
  "properties": {
    "v": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "model": {"type": "string"},
    "input_tokens": {"type": "integer", "minimum": 0},
    "cached_input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "reasoning_tokens": {"type": "integer", "minimum": 0},
    "cost_usd": {"type": "number", "minimum": 0},
    "cost_source": {"enum": ["provider", "pricing_table", "manual", "unknown"]},
    "latency_ms": {"type": "integer", "minimum": 0},
    "status": {"type": "integer", "minimum": 0, "maximum": 599},
    "source": {"type": "string"},
    "step": {"type": "integer", "minimum": 1, "description": "1-based step inside the run; absent for one-shot requests."},
    "model_id": {"type": "string", "minLength": 1, "description": "真实 provider 模型 id；model 是配置别名。"},
    "tool_names": {"type": "array", "items": {"type": "string"}, "description": "本步模型调用的工具名（不含 finish）。"},
    "write_paths": {"type": "array", "items": {"type": "string"}, "description": "本步整文件写入的路径（edit 不算）。"},
    "rewrite_count": {"type": "integer", "minimum": 0, "description": "本步对已写文件的重复整文件覆盖次数。"},
    "history_bytes": {"type": "integer", "minimum": 0, "description": "投影前的序列化历史字节数。"},
    "projected_bytes": {"type": "integer", "minimum": 0, "description": "实际发送的序列化历史字节数。"}
  }
}
