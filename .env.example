# Local provider credential template.
#
# Usage: copy to .env.local (ignored by the `.env.*` rule in .gitignore) and fill in real values.
# Never commit real keys into the repository, and never paste them into chat/issues/logs.
# Only the names below are passed through the scripts/dev.sh whitelist into the container
# (a fixed list plus any exported *_API_KEY / *_API_BASE).
#
# After filling this in, run `loom model init`: it probes *_API_BASE/_API_KEY pairs and
# generates [[models]] entries — item-by-item confirmation under a TTY, preview-only by
# default without a TTY, direct write with --yes.
#
# Both relays are filled in using the OpenAI-compatible interface (native goes through /chat/completions).

# DeepSeek relay
export LOOM_DEEPSEEK_API_BASE="https://your-relay.example.com/v1"
export LOOM_DEEPSEEK_API_KEY="sk-..."

# GPT relay
export LOOM_GPT_API_BASE="https://your-relay.example.com/v1"
export LOOM_GPT_API_KEY="sk-..."

# DeepSeek official (used to check the "relay does not support toolcalls" hypothesis).
# Point [[models]] here with base_url + key_env; the key value still lives only in this file:
#   [[models]]
#   alias = "deepseek-official"
#   base_url = "https://api.deepseek.com/v1"
#   key_env = "DEEPSEEK_OFFICIAL_API_KEY"
# export DEEPSEEK_OFFICIAL_API_BASE="https://api.deepseek.com/v1"
# export DEEPSEEK_OFFICIAL_API_KEY="sk-..."

# You can also set this generic pair directly (simplest for a single provider):
# export LOOM_API_BASE="https://your-relay.example.com/v1"
# export LOOM_API_KEY="sk-..."
